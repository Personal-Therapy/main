<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_gradient"
    tools:context=".MainActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@drawable/bg_top_bar"
        app:elevation="2dp"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.Toolbar
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:contentInsetStart="24dp"
            app:contentInsetEnd="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Personal Therapy"
                android:fontFamily="@font/pacifico"
                android:textColor="@color/main_text_primary"
                android:textSize="20sp" />

        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        app:layout_constraintTop_toBottomOf="@id/appBarLayout"
        app:layout_constraintBottom_toTopOf="@+id/bottomNavView">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="24dp"> <TextView
            android:id="@+id/tvGreeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="안녕하세요!"
            android:textColor="@color/main_text_primary"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvGreetingSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="오늘 하루는 어떠셨나요? 마음의 건강을 함께 돌봐드릴게요."
                android:textColor="@color/main_text_secondary"
                android:textSize="14sp"
                android:lineHeight="21sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvGreeting" />

            <androidx.cardview.widget.CardView
                android:id="@+id/cardMoodCheck"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:layout_constraintTop_toBottomOf="@id/tvGreetingSubtitle">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="24dp">

                    <TextView
                        android:id="@+id/tvMoodCheckTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="빠른 기분 체크"
                        android:textColor="@color/main_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvMoodCheckSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="현재 기분을 1-10으로 표현해주세요"
                        android:textColor="@color/main_text_secondary"
                        android:textSize="14sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvMoodCheckTitle" />

                    <TextView
                        android:id="@+id/tvSeekbarMin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="1"
                        android:textColor="@color/main_text_tertiary"
                        android:textSize="14sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvMoodCheckSubtitle" />

                    <SeekBar
                        android:id="@+id/seekBarMood"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:max="9"
                        android:progress="4"
                        android:progressDrawable="@drawable/bg_seekbar_gradient"
                        android:thumbTint="@color/main_seekbar_thumb"
                        app:layout_constraintBottom_toBottomOf="@id/tvSeekbarMin"
                        app:layout_constraintEnd_toStartOf="@id/tvSeekbarMax"
                        app:layout_constraintStart_toEndOf="@id/tvSeekbarMin"
                        app:layout_constraintTop_toTopOf="@id/tvSeekbarMin" />

                    <TextView
                        android:id="@+id/tvSeekbarMax"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="10"
                        android:textColor="@color/main_text_tertiary"
                        android:textSize="14sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/tvSeekbarMin" />

                    <TextView
                        android:id="@+id/tvMoodValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="5"
                        android:textColor="@color/main_button_blue"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/seekBarMood" />

                    <Button
                        android:id="@+id/btnAnalyzeMood"
                        android:layout_width="0dp"
                        android:layout_height="45dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_button_blue"
                        android:text="기분 분석하기"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvMoodValue" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/menuGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@id/cardMoodCheck">

                <androidx.constraintlayout.helper.widget.Flow
                    android:id="@+id/flowMenu"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:flow_wrapMode="chain"
                    app:flow_horizontalStyle="spread_inside"
                    app:flow_maxElementsWrap="2"
                    app:flow_horizontalGap="16dp"
                    app:flow_verticalGap="16dp"
                    app:constraint_referenced_ids="cardDiagnosis, cardHealing"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardDiagnosis"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:layout_constraintWidth_default="percent"
                    app:layout_constraintWidth_percent="0.48">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="24dp">

                        <ImageView
                            android:id="@+id/cardDiagnosisIcon"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginBottom="12dp"
                            android:background="@drawable/bg_icon_purple"
                            android:padding="12dp"
                            android:src="@android:drawable/ic_menu_search"
                            app:tint="#9333EA"/>

                        <TextView
                            android:id="@+id/cardDiagnosisTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="정신건강 진단"
                            android:textColor="@color/main_text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="4dp"/>

                        <TextView
                            android:id="@+id/cardDiagnosisSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="32dp"
                            android:text="전문적인 심리 상태 체크"
                            android:textColor="@color/main_text_secondary"
                            android:textSize="12sp"
                            android:lineHeight="16sp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardHealing"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:layout_constraintWidth_default="percent"
                    app:layout_constraintWidth_percent="0.48">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="24dp">

                        <ImageView
                            android:id="@+id/cardHealingIcon"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginBottom="12dp"
                            android:background="@drawable/bg_icon_orange"
                            android:padding="12dp"
                            android:src="@android:drawable/ic_menu_compass"
                            app:tint="#EA580C"/>

                        <TextView
                            android:id="@+id/cardHealingTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="힐링 콘텐츠"
                            android:textColor="@color/main_text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="4dp"/>

                        <TextView
                            android:id="@+id/cardHealingSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="32dp"
                            android:text="맞춤형 치유 콘텐츠"
                            android:textColor="@color/main_text_secondary"
                            android:textSize="12sp"
                            android:lineHeight="16sp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardTodayHealing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:layout_constraintTop_toBottomOf="@id/menuGrid">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="24dp">

                    <TextView
                        android:id="@+id/tvTodayHealingTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="오늘의 힐링"
                        android:textColor="@color/main_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardVideo"
                        android:layout_width="match_parent"
                        android:layout_height="128dp"
                        android:layout_marginTop="16dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:layout_constraintTop_toBottomOf="@id/tvTodayHealingTitle">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <ImageView
                                android:id="@+id/ivHealingThumbnail"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:src="@android:drawable/sym_def_app_icon"
                                android:background="#AAAAAA"/>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="#33000000" />

                            <ImageView
                                android:id="@+id/ivPlayButton"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:background="@drawable/bg_play_button"
                                android:src="@android:drawable/ic_media_play"
                                android:padding="12dp"
                                app:tint="@color/main_text_primary"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </androidx.cardview.widget.CardView>

                    <TextView
                        android:id="@+id/tvHealingVideoTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="5분 명상으로 마음 정리하기"
                        android:textColor="@color/main_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/cardVideo"/>

                    <TextView
                        android:id="@+id/tvHealingVideoSubtitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="스트레스를 줄이고 마음의 평화를 찾는 간단한 명상법을 배워보세요."
                        android:textColor="@color/main_text_secondary"
                        android:textSize="14sp"
                        android:lineHeight="20sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvHealingVideoTitle"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardEmergency"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="@color/main_emergency_bg"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/main_emergency_border"
                app:strokeWidth="1dp"
                app:layout_constraintTop_toBottomOf="@id/cardTodayHealing">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="24dp">

                    <ImageView
                        android:id="@+id/ivEmergencyIconBg"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_icon_red_circle"
                        android:src="@android:drawable/ic_dialog_alert"
                        android:padding="6dp"
                        app:tint="@color/main_emergency_button_red"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvEmergencyTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="긴급 상황 시"
                        android:textColor="@color/main_emergency_text_dark"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="@id/ivEmergencyIconBg"
                        app:layout_constraintStart_toEndOf="@id/ivEmergencyIconBg"
                        app:layout_constraintTop_toTopOf="@id/ivEmergencyIconBg" />

                    <TextView
                        android:id="@+id/tvEmergencySubtitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="위기 상황이거나 즉시 도움이 필요하시다면 주저하지 마시고 연락하세요."
                        android:textColor="@color/main_emergency_text_light"
                        android:textSize="14sp"
                        android:lineHeight="20sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/ivEmergencyIconBg"/>

                    <Button
                        android:id="@+id/btnEmergencyCall"
                        android:layout_width="0dp"
                        android:layout_height="45dp"
                        android:layout_marginTop="16dp"
                        android:text="생명의전화 1393"
                        android:backgroundTint="@color/main_emergency_button_red"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        app:cornerRadius="12dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvEmergencySubtitle"/>

                    <Button
                        android:id="@+id/btnEmergencyConsult"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="전문가와 즉시 상담"
                        android:background="@drawable/bg_button_red_outline"
                        android:textColor="@color/main_emergency_button_red"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/btnEmergencyCall"/>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <View
        android:id="@+id/navDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/main_nav_border"
        app:layout_constraintBottom_toTopOf="@id/bottomNavView" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:itemIconSize="20dp"
        app:itemIconTint="@color/bottom_nav_colors"
        app:itemTextColor="@color/bottom_nav_colors"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:menu="@menu/bottom_nav_menu" />

</androidx.constraintlayout.widget.ConstraintLayout>